@using HelpDeskApp.ViewModels.Models.Project
@model IEnumerable<ProjectIndexVM>

@{
    ViewData["Title"] = "Favorite Projects";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-semibold mb-1">
                Favorite Projects
            </h4>

            <p class="text-muted small mb-0">
                Projects you have added to your favorites
            </p>
        </div>

        <a asp-controller="Project"
           asp-action="Index"
           class="btn text-white"
           style="background-color:#875a7b">
            All Projects
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <div class="mb-3"
                     style="font-size:2rem;">
                    ☆
                </div>

                <h5 class="fw-semibold">
                    No favorite projects
                </h5>

                <p class="text-muted mb-4">
                    You have not added any projects
                    to your favorites yet.
                </p>

                <a asp-controller="Project"
                   asp-action="Index"
                   class="btn text-white"
                   style="background-color:#875a7b">
                    Browse Projects
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (ProjectIndexVM project in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <span class="text-muted text-uppercase small">
                                        Project #@project.Id
                                    </span>

                                    <h5 class="fw-semibold mt-1 mb-0">
                                        @project.ProjectName
                                    </h5>
                                </div>

                                <span class="badge rounded-pill"
                                      style="background-color:#f3edf2; color:#875a7b;">
                                    ★ Favorite
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(project.Description))
                            {
                                <p class="text-muted small mb-3">
                                    @project.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted small mb-3">
                                    No description available.
                                </p>
                            }

                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">

                                <a asp-controller="Project"
                                   asp-action="Details"
                                   asp-route-id="@project.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Details
                                </a>

                                <form asp-controller="ProjectFavorite"
                                      asp-action="Remove"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="projectId"
                                           value="@project.Id" />

                                    <button type="submit"
                                            class="btn btn-sm text-white"
                                            style="background-color:#875a7b">
                                        ★ Favorite
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}