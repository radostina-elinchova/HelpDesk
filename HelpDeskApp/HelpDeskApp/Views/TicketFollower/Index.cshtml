@using HelpDeskApp.ViewModels.Models.Ticket

@model IEnumerable<TicketListVM>

@{
    ViewData["Title"] = "Following";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">
                Following
            </h4>

            <p class="text-muted small mb-0">
                Tickets you are currently following
            </p>
        </div>

        <a asp-controller="Ticket"
           asp-action="Index"
           class="btn text-white"
           style="background-color:#875a7b">
            All Tickets
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <div class="mb-3"
                     style="font-size:2rem;">
                    ☆
                </div>

                <h5 class="fw-semibold">
                    No followed tickets
                </h5>

                <p class="text-muted mb-4">
                    You are not following any tickets yet.
                </p>

                <a asp-controller="Ticket"
                   asp-action="Index"
                   class="btn text-white"
                   style="background-color:#875a7b">
                    Browse Tickets
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var ticket in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <span class="text-muted text-uppercase small">
                                        Ticket #@ticket.Id
                                    </span>

                                    <h5 class="fw-semibold mt-1 mb-0">
                                        @ticket.Title
                                    </h5>
                                </div>

                                <span class="badge rounded-pill"
                                      style="background-color:#f3edf2; color:#875a7b;">
                                    @ticket.Status
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(ticket.Title))
                            {
                                <p class="text-muted small mb-3">
                                    @ticket.Title
                                </p>
                            }

                            <div class="mb-3">

                                <div class="text-muted text-uppercase small">
                                    Project
                                </div>

                                <div class="fw-semibold">
                                    @ticket.ProjectName
                                </div>

                            </div>

                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">

                                <a asp-controller="Ticket"
                                   asp-action="Details"
                                   asp-route-id="@ticket.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Details
                                </a>

                                <form asp-controller="TicketFollower"
                                      asp-action="Unfollow"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="ticketId"
                                           value="@ticket.Id" />

                                    <button type="submit"
                                            class="btn btn-sm text-white"
                                            style="background-color:#875a7b">
                                        ★ Following
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
