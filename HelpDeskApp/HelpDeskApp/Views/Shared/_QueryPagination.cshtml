@model HelpDeskApp.ViewModels.Models.Common.QueryPaginationVM

@if (Model.TotalPages > 1)
{
    <div class="o-pagination-bar mt-3">
        <span class="o-pagination-info">
            Page @Model.CurrentPage of @Model.TotalPages
        </span>

        <div class="o-pagination-actions">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="@Model.Action"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-favoritesOnly="@Model.FavoritesOnly"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-statusId="@Model.StatusId"
                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="o-page-button">
                    ‹
                </a>
            }
            else
            {
                <span class="o-page-button disabled">
                    ‹
                </span>
            }

            @for (int pageNumber = 1;
                    pageNumber <= Model.TotalPages;
                    pageNumber++)
            {
                <a asp-action="@Model.Action"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-favoritesOnly="@Model.FavoritesOnly"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-statusId="@Model.StatusId"
                   asp-route-currentPage="@pageNumber"
                   asp-route-pageSize="@Model.PageSize"
                   class="o-page-button
                                  @(pageNumber == Model.CurrentPage
                                                 ? "active"
                                                 : string.Empty)">

            @pageNumber
        </a>
                }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="@Model.Action"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-favoritesOnly="@Model.FavoritesOnly"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-statusId="@Model.StatusId"
                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="o-page-button">
                    ›
                </a>
            }
            else
            {
                <span class="o-page-button disabled">
                    ›
                </span>
            }
        </div>
    </div>
}