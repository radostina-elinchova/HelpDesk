<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpDeskApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/odoo.css" asp-append-version="true" />
</head>

<body class="odoo-body">

    <header class="odoo-topbar">
        <div class="odoo-topbar-left">


            <nav class="odoo-menu">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="odoo-logo">
                    HelpDesk
                </a>
                @if (User.IsInRole("Administrator"))
                {
                    <li class="nav-item dropdown o-admin-nav">

                         <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Home"
                                   asp-action="Index">
                            Administration
                        </a>

                        @* <ul class="dropdown-menu o-admin-dropdown">

                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                             <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="UserManagement"
                                   asp-action="Index">
                                    User Management
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="ProjectManagement"
                                   asp-action="Index">
                                    Project Management
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="TicketManagement"
                                   asp-action="Manage">
                                    Ticket Management
                                </a>
                            </li>

                        </ul> *@

                    </li>
                }
               @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area=""
                       asp-controller="Project"
                       asp-action="Index"
                       class="odoo-menu-item">
                        Projects
                    </a>

                    <a asp-area=""
                       asp-controller="Ticket"
                       asp-action="Index"
                       class="odoo-menu-item">
                        Tickets
                    </a>


                    @if (!User.IsInRole("Administrator"))
                    {
                        <a asp-area=""
                           asp-controller="ProjectFavorite"
                           asp-action="Index"
                           class="odoo-menu-item">
                            Favorites
                        </a>
                    }


                    <a asp-area=""
                       asp-controller="TicketFollower"
                       asp-action="Index"
                       class="odoo-menu-item">
                        Following
                    </a>
                }

            </nav>

        </div>


        <!-- LOGIN -->
        <div class="odoo-topbar-right">
            <partial name="_LoginPartial" />
        </div>

    </header>

      @if (User.Identity?.IsAuthenticated == true)
        {
            <div id="notification-container"
                 class="container mt-3">
            </div>
        }
    <main class="odoo-main">
      
        @RenderBody()
    </main>


    <footer class="odoo-footer">
        © 2026 HelpDeskApp
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/microsoft/signalr/dist/browser/signalr.min.js"> </script>
        <script src="~/js/notifications.js"></script>
    }
</body>
</html>