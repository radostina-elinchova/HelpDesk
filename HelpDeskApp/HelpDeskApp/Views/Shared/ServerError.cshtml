@{
    ViewData["Title"] = "500 Internal Server Error";
}

<div class="odoo-container">
    <div class="o-error-page">
        <div class="o-error-icon o-error-danger">
            500
        </div>

        <h1 class="o-error-title">
            Internal Server Error
        </h1>

        <p class="o-error-description">
            Something went wrong on our end.
            <br />
            Please try again later.
        </p>

        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="btn odoo-btn-primary">
            Back to Home
        </a>
    </div>
</div>