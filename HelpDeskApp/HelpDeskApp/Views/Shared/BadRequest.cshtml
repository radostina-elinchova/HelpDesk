@{
    ViewData["Title"] = "400 Bad Request";
}

<div class="odoo-container">
    <div class="o-error-page">
        <div class="o-error-icon o-error-danger">
            400
        </div>

        <h1 class="o-error-title">
            Bad Request
        </h1>

        <p class="o-error-description">
            The request is invalid and could not be processed.
        </p>

        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="btn odoo-btn-primary">
            Back to Home
        </a>
    </div>
</div>