@using HelpDeskApp.ViewModels.Models.Project
@using HelpDeskApp.ViewModels.Models.Common

@model ProjectQueryVM

@{
    ViewData["Title"] = "Projects";
}

<div class="odoo-container">
    <div class="odoo-action-bar">
        <div>
            <h3>@ViewData["Title"]</h3>

            <span class="o-record-count">
                @Model.Result.TotalItems projects
            </span>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Project"
               asp-action="Create"
               class="btn odoo-btn-primary">
                + Create
            </a>
        }
    </div>

    <form asp-controller="Project"
          asp-action="Index"
          method="get"
          class="o-search-panel mb-3">

        <input asp-for="SearchTerm"
               class="o-search-input"
               placeholder="Search project name or description..." />

        @if (!User.IsInRole("Administrator"))
        {
            <label class="o-filter-check">
                <input asp-for="FavoritesOnly" />
                Favorites only
            </label>
        }

        <select asp-for="PageSize"
                class="o-search-select">
            <option value="6">6 per page</option>
            <option value="12">12 per page</option>
            <option value="24">24 per page</option>
        </select>

        <button type="submit"
                class="btn odoo-btn-primary">
            Search
        </button>

        <a asp-controller="Project"
           asp-action="Index"
           class="btn odoo-btn-secondary">
            Clear
        </a>
    </form>

    @if (Model.Result.Items.Any())
    {
        <div class="odoo-kanban">
            @foreach (var project in Model.Result.Items)
            {
                <div class="odoo-kanban-card">
                    <div class="odoo-kanban-header">
                        <span class="odoo-kanban-title">
                            @project.ProjectName
                        </span>

                        @if (!User.IsInRole("Administrator"))
                        {
                            @if (project.IsFavorite)
                            {
                                <form asp-controller="ProjectFavorite"
                                      asp-action="Remove"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="projectId"
                                           value="@project.Id" />

                                    <button type="submit"
                                            class="btn btn-link text-decoration-none">
                                        ★
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="ProjectFavorite"
                                      asp-action="Add"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="projectId"
                                           value="@project.Id" />

                                    <button type="submit"
                                            class="btn btn-link text-decoration-none">
                                        ☆
                                    </button>
                                </form>
                            }
                        }
                    </div>

                    <div class="odoo-kanban-body">
                        <p class="odoo-kanban-description">
                            @project.Description
                        </p>
                    </div>

                    <div class="odoo-kanban-footer">
                        <a asp-controller="Project"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="odoo-link">
                            Open
                        </a>

                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-controller="Project"
                               asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="odoo-link">
                                Edit
                            </a>

                            <a asp-controller="Project"
                               asp-action="Delete"
                               asp-route-id="@project.Id"
                               class="odoo-link odoo-link-danger">
                                Delete
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <partial name="_QueryPagination"
                 model="@(new QueryPaginationVM
                 {
                     Action = "Index",
                     CurrentPage = Model.Result.CurrentPage,
                     TotalPages = Model.Result.TotalPages,
                     PageSize = Model.Result.PageSize,
                     SearchTerm = Model.SearchTerm,
                     FavoritesOnly = Model.FavoritesOnly
                 })" />
    }
    else
    {
        <div class="odoo-no-data text-center p-5">
            <h4 class="text-muted">
                No projects found
            </h4>

            <p>
                Try changing the search text or favorite filter.
            </p>

            <a asp-controller="Project"
               asp-action="Index"
               class="btn odoo-btn-secondary">
                Clear filters
            </a>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}