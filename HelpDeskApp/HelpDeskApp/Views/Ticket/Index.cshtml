@using HelpDeskApp.ViewModels.Models.Ticket
@using HelpDeskApp.ViewModels.Models.Common

@model TicketQueryVM

@{
    ViewData["Title"] = "Tickets";
}

<div class="odoo-container">
    <div class="odoo-action-bar">
        <div>
            <h3>@ViewData["Title"]</h3>

            <span class="o-record-count">
                @Model.Result.TotalItems tickets
            </span>
        </div>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Ticket"
            asp-action="Create" 
            class="btn odoo-btn-primary">
            + Create
        </a>
        }
    </div>

    <form asp-controller="Ticket"
          asp-action="Index"
          method="get"
          class="o-search-panel mb-3">

        <input asp-for="SearchTerm"
               class="o-search-input"
               placeholder="Search ticket title or description..." />

        <select asp-for="ProjectId"
                class="o-search-select">

            <option value="">All projects</option>

            @foreach (var project in Model.Projects)
            {
                <option value="@project.Id">
                    @project.ProjectName
                </option>
            }
        </select>

        <select asp-for="StatusId"
                class="o-search-select">

            <option value="">All statuses</option>

            @foreach (var status in Model.Statuses)
            {
                <option value="@status.Id">
                    @status.Name
                </option>
            }
        </select>

        <select asp-for="PageSize"
                class="o-search-select">

            <option value="6">6 per page</option>
            <option value="12">12 per page</option>
            <option value="24">24 per page</option>
        </select>

        <button type="submit"
                class="btn odoo-btn-primary">
            Search
        </button>

        <a asp-controller="Ticket"
           asp-action="Index"
           class="btn odoo-btn-secondary">
            Clear
        </a>
    </form>

    @if (Model.Result.Items.Any())
    {
        <div class="odoo-kanban">
            @foreach (var ticket in Model.Result.Items)
            {
                <div class="odoo-kanban-card">
                    <div class="odoo-kanban-header
                                d-flex
                                justify-content-between
                                align-items-center">

                        <span class="odoo-kanban-title">
                            @ticket.Title
                        </span>

                        <span class="o-role-badge">
                            @ticket.Status
                        </span>
                    </div>

                    <div class="odoo-kanban-body">
                        <div class="odoo-kanban-meta">
                            <span class="odoo-kanban-label">
                                Project
                            </span>

                            <span class="odoo-kanban-value">
                                @ticket.ProjectName
                            </span>
                        </div>

                        <div class="odoo-kanban-meta">
                            <span class="odoo-kanban-label">
                                Created by
                            </span>

                            <span class="odoo-kanban-value">
                                @ticket.CreatorName
                            </span>
                        </div>
                    </div>

                    <div class="odoo-kanban-footer">
                        <a asp-controller="Ticket"
                           asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="odoo-link">
                            Open
                        </a>

                        @if (ticket.IsFollowing)
                        {
                            <form asp-controller="TicketFollower"
                                  asp-action="Unfollow"
                                  method="post"
                                  class="d-inline-flex align-items-center">

                                <input type="hidden"
                                       name="ticketId"
                                       value="@ticket.Id" />

                                <button type="submit"
                                        class="odoo-link">
                                    Unfollow
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="TicketFollower"
                                  asp-action="Follow"
                                  method="post"
                                  class="d-inline-flex align-items-center">

                                <input type="hidden"
                                       name="ticketId"
                                       value="@ticket.Id" />

                                <button type="submit"
                                        class="odoo-link">
                                    Follow
                                </button>
                            </form>
                        }

                        @if (User.IsInRole("Administrator") || ticket.IsCteator)
                        {
                            <a asp-controller="Ticket"
                               asp-action="Edit"
                               asp-route-id="@ticket.Id"
                               class="odoo-link">
                                Edit
                            </a>

                            <a asp-controller="Ticket"
                               asp-action="Delete"
                               asp-route-id="@ticket.Id"
                               class="odoo-link odoo-link-danger">
                                Delete
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <partial name="_QueryPagination"
                 model="@(new QueryPaginationVM
                 {
                     Action = "Index",
                     CurrentPage = Model.Result.CurrentPage,
                     TotalPages = Model.Result.TotalPages,
                     PageSize = Model.Result.PageSize,
                     SearchTerm = Model.SearchTerm,
                     ProjectId = Model.ProjectId,
                     StatusId = Model.StatusId
                 })" />
    }
    else
    {
        <div class="odoo-no-data text-center p-5">
            <h4 class="text-muted">
                No tickets found
            </h4>

            <p>
                Try changing the search text or selected filters.
            </p>

            <a asp-controller="Ticket"
               asp-action="Index"
               class="btn odoo-btn-secondary">
                Clear filters
            </a>
        </div>
    }
</div>